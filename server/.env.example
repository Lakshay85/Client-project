# ==============================================================================
# FormEnclave Server Environment Configuration
# ==============================================================================
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,https://client-project-nine-liart.vercel.app
JWT_SECRET=replace-this-with-a-long-random-secret

# ==============================================================================
# Database Configuration Toggle
# ==============================================================================
# DB_MODE options: "local" (Local MySQL) or "cloud" (Aiven Cloud MySQL)
# Current active status: local development
DB_MODE=local

# --- Local MySQL Database Config ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=client_project
DB_USER=root
DB_PASSWORD=root

# --- Cloud MySQL Database Config (Aiven MySQL) ---
CLOUD_DB_HOST=your_cloud_host_here
CLOUD_DB_PORT=20341
CLOUD_DB_NAME=defaultdb
CLOUD_DB_USER=avnadmin
CLOUD_DB_PASSWORD=your_cloud_password_here
CLOUD_DB_SSL=true

# ==============================================================================
# Google OAuth Configuration
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
